# ── Docker Compose overrides ──────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_db_password_here
POSTGRES_DB=campus_events_db
POSTGRES_PORT=5432

REDIS_PORT=6379

BACKEND_PORT=5000
FRONTEND_PORT=5173

# ── App URLs ──────────────────────────────────────────────────────────────────
APP_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173
APP_NAME=Campus Event Management System

# ── JWT (generate with: openssl rand -hex 64) ─────────────────────────────────
JWT_SECRET=replace_with_64_char_random_hex_string
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=replace_with_another_64_char_random_hex_string
REFRESH_TOKEN_EXPIRES_IN=7d

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
EMAIL_FROM=noreply@campusevents.edu

# ── File upload ───────────────────────────────────────────────────────────────
MAX_FILE_SIZE=5242880
